# Copy to .env and change the values
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Supabase > Project Settings > Database > Connection string
# DATABASE_URL: "Transaction pooler" string (port 6543) - used by the running app
# DIRECT_URL:   "Direct connection" string (port 5432) - used to create tables at startup and for migrations
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Folder where uploaded images (product photos, payment receipts) are kept (use a persistent disk on hosting)
DATA_DIR=./data
