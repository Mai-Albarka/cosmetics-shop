<%- include('partials/dash_header') %>
<h1>Change password</h1>
<div class="card narrow">
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="/account/password">
    <label>Current password <input type="password" name="current" required></label>
    <label>New password <input type="password" name="password" required minlength="6"></label>
    <label>Confirm new password <input type="password" name="confirm" required minlength="6"></label>
    <button class="btn primary">Save</button>
  </form>
</div>
<%- include('partials/dash_footer') %>
