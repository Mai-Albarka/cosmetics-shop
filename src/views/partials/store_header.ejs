<%- include('head') %>
<body class="store">
<div class="gold-line"></div>
<header class="store-header">
  <div class="wrap bar">
    <a class="brand" href="/"><span class="brand-mark">✦</span> <%= shop.shop_name %></a>
    <nav>
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Shop</a>
      <a href="/track" class="<%= path === '/track' ? 'on' : '' %>">Track order</a>
      <a href="/cart" class="cart-link <%= path === '/cart' ? 'on' : '' %>">Cart <span id="cart-count" class="badge">0</span></a>
      <% if (user) { %><a href="<%= user.role === 'admin' ? '/admin' : '/pos' %>">Staff area</a><% } %>
    </nav>
  </div>
</header>
<main class="wrap page-enter">
<%- include('flash') %>
