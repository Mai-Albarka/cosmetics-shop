<%- include('../partials/dash_header') %>
<h1><%= title %></h1>
<form method="post" action="/admin/products<%= p.id ? '/' + p.id : '' %>" enctype="multipart/form-data" class="card narrow">
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <label>Name <input name="name" required value="<%= p.name %>"></label>
  <label>Category <select name="category_id"><option value="">— none —</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= p.category_id == c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label>
  <label>Price (₦) <input type="number" name="price" step="0.01" min="0" required value="<%= p.price %>"></label>
  <div class="row">
    <label class="grow">Stock quantity <input type="number" name="stock" min="0" value="<%= p.stock %>"></label>
    <label class="grow">Low-stock alert at <input type="number" name="low_stock" min="0" value="<%= p.low_stock %>"></label>
  </div>
  <label>Description <textarea name="description" rows="3"><%= p.description %></textarea></label>
  <label>Photo <input type="file" name="image" accept="image/*"></label>
  <% if (p.image) { %><div class="row"><img class="mini" src="/uploads/products/<%= p.image %>" alt=""><label class="inline"><input type="checkbox" name="remove_image" value="1"> Remove current photo</label></div><% } %>
  <label class="inline"><input type="checkbox" name="active" value="1" <%= p.active ? 'checked' : '' %>> Visible in the online shop</label>
  <div class="row top-gap"><button class="btn primary">Save product</button><a class="btn" href="/admin/products">Cancel</a></div>
</form>
<%- include('../partials/dash_footer') %>
