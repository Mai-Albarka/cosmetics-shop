<%- include('../partials/dash_header') %>
<div class="row between">
  <div><h1><%= o.invoice_no %> <span class="tag <%= statusClass(o.status) %>"><%= statusLabel(o.status) %></span></h1>
    <div class="muted"><%= o.type === 'pos' ? 'Shop sale' : 'Online order' %> · placed <%= fmtDate(o.created_at) %></div></div>
  <div class="row">
    <a class="btn" href="/pos/sale/<%= o.id %>/pdf">Download PDF</a>
    <% if (o.type === 'online') { %><a class="btn" href="/order/<%= o.invoice_no %>?token=<%= o.token %>" target="_blank">Customer view</a><% } %>
  </div>
</div>
<div class="two-col">
  <div>
    <div class="card">
      <h2>Customer</h2>
      <p><strong><%= o.customer_name || 'Walk-in customer' %></strong><br><%= o.customer_phone %><br><%= o.customer_address %></p>
      <% if (o.note) { %><p class="muted">Note: <%= o.note %></p><% } %>
      <% if (o.sold_by_name) { %><p class="small muted">Sold by <%= o.sold_by_name %> · <%= PAYMENT_METHODS[o.payment_method] || o.payment_method %></p><% } %>
      <% if (o.confirmed_by_name) { %><p class="small muted">Payment confirmed by <%= o.confirmed_by_name %> on <%= fmtDate(o.confirmed_at) %></p><% } %>
      <% if (o.collected_by_name) { %><p class="small muted">Collected, handled by <%= o.collected_by_name %> on <%= fmtDate(o.collected_at) %></p><% } %>
    </div>
    <div class="card">
      <h2>Items</h2>
      <table class="table compact">
        <tbody><% o.items.forEach(i => { %><tr><td><%= i.name %></td><td class="r"><%= i.qty %> × <%= fmtMoney(i.price) %></td><td class="r"><%= fmtMoney(i.line_total) %></td></tr><% }) %></tbody>
        <tfoot><% if (o.discount > 0) { %><tr><td colspan="2" class="r">Discount</td><td class="r">-<%= fmtMoney(o.discount) %></td></tr><% } %>
        <tr><td colspan="2" class="r"><strong>Total</strong></td><td class="r"><strong><%= fmtMoney(o.total) %></strong></td></tr></tfoot>
      </table>
    </div>
  </div>
  <div>
    <% if (o.status === 'cancelled' && o.rejected_reason) { %><div class="flash flash-error"><strong><%= o.type === 'pos' ? 'VOIDED' : 'CANCELLED' %></strong> · <%= o.rejected_reason %></div><% } %>
    <% if (o.type === 'pos' && o.status === 'collected') { %>
    <div class="card">
      <h2>Void this sale</h2>
      <p class="small muted">Only the owner can do this. The sale is never deleted: it stays in the records marked VOIDED with your reason, and the stock is returned.</p>
      <form method="post" action="/admin/orders/<%= o.id %>/void" class="row" onsubmit="return confirm('Void this sale?')">
        <input name="reason" placeholder="Reason (required)" required class="grow"><button class="btn danger">Void sale</button>
      </form>
    </div>
    <% } %>
    <% if (o.type === 'online') { %>
    <div class="card">
      <h2>Payment receipt from customer</h2>
      <% if (!o.payment_proof) { %><p class="muted">The customer has not uploaded a receipt yet.</p><% } else { %>
        <p class="small muted">Uploaded <%= fmtDate(o.payment_submitted_at) %><% if (o.payment_note) { %> · "<%= o.payment_note %>"<% } %></p>
        <% if (/\.pdf$/i.test(o.payment_proof)) { %><a class="btn" href="/payment-proof/<%= o.invoice_no %>" target="_blank">Open uploaded PDF</a>
        <% } else { %><a href="/payment-proof/<%= o.invoice_no %>" target="_blank"><img class="proof" src="/payment-proof/<%= o.invoice_no %>" alt="Payment receipt"></a><% } %>
        <p class="small">Check your bank account for <strong><%= fmtMoney(o.total) %></strong> with reference <strong><%= o.invoice_no %></strong> before confirming.</p>
      <% } %>
      <% if (['payment_submitted', 'pending_payment'].includes(o.status)) { %>
        <div class="row">
          <form method="post" action="/admin/orders/<%= o.id %>/confirm"><button class="btn primary big-btn">Confirm payment received</button></form>
        </div>
        <form method="post" action="/admin/orders/<%= o.id %>/reject" class="row top-gap">
          <input name="reason" placeholder="Reason (shown to customer)" class="grow"><button class="btn danger">Reject receipt</button>
        </form>
      <% } %>
      <% if (o.status === 'confirmed') { %>
        <form method="post" action="/admin/orders/<%= o.id %>/collect" class="top-gap"><button class="btn primary">Mark as collected</button></form>
      <% } %>
      <% if (!['collected', 'cancelled'].includes(o.status)) { %>
        <form method="post" action="/admin/orders/<%= o.id %>/cancel" class="top-gap" onsubmit="return confirm('Cancel this order?')"><button class="btn linklike danger-text">Cancel order</button></form>
      <% } %>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/dash_footer') %>
